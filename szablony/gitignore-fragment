# Fragment .gitignore do zabrania do wlasnego projektu.
#
# Czesc uniwersalna (Python, edytory, systemowe) idzie bez zmian. Wpisy oznaczone
# jako PRZYKLAD sa z repozytorium cwiczeniowego kursu i wymagaja podmiany -
# zostawione, bo pokazuja, CO warto ignorowac, nie ktore konkretnie pliki.

# Python
__pycache__/
*.pyc
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Sekrety i konfiguracja lokalna
.env
.env.local

# Claude Code: ustawienia osobiste i worktree
# settings.local.json jest indywidualny, settings.json zespolowy - ten drugi
# zostaje w repozytorium i przechodzi przez review.
.claude/settings.local.json
.claude/worktrees/

# PRZYKLAD - baza generowana ze skryptu, nie commitowana:
# generator nie jest deterministyczny miedzy wersjami biblioteki SQLite
# (ta sama zawartosc logiczna, inny uklad stron pliku), wiec commitowany plik
# brudzilby sie u kazdego i blokowal `git checkout`.
# Ta sama zasada dotyczy kazdego artefaktu odtwarzalnego z kodu.
rozliczenia.db
*.db-journal
*.db-wal
*.db-shm

# PRZYKLAD - katalog na notatki robocze, ktore nie sa produktem projektu
notatki/

# Systemowe i kopie zapasowe (m.in. po `sed -i.bak`)
.DS_Store
Thumbs.db
*.bak
*.orig
*.swp

# Edytory
.idea/
.vscode/
